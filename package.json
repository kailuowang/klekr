{
  "name": "klekr",
  "version": "1.0.0",
  "description": "[klekr](http://klekr.com/) - Your personal flickr explorer ==================================================",
  "private": true,
  "directories": {
    "doc": "doc",
    "lib": "lib"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --outdir=app/assets/builds --public-path=assets",
    "build:css": "sass ./app/assets/stylesheets/application.sass:./app/assets/builds/application.css --no-source-map --load-path=node_modules",
    "test": "jasmine spec/node/simpleTest.js spec/node/pictureSpec.js",
    "test:all": "jasmine"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kailuowang/klekr.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kailuowang/klekr/issues"
  },
  "homepage": "https://github.com/kailuowang/klekr#readme",
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.0-beta.2",
    "esbuild": "^0.19.11",
    "jquery": "^3.7.1",
    "sass": "^1.70.0"
  },
  "devDependencies": {
    "esbuild-sass-plugin": "^2.9.0",
    "jasmine": "^5.6.0"
  }
}
